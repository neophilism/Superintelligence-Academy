{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academy lesson registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "lessons",
    "courses"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lesson"
      }
    },
    "courses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/course"
      }
    }
  },
  "$defs": {
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "level",
        "anchor",
        "domain",
        "title",
        "content",
        "example",
        "prerequisites",
        "visibility",
        "approvedBy",
        "reviewedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{3,100}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "level": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "L5"
          ]
        },
        "anchor": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.[a-z][a-z0-9-]*$"
        },
        "domain": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160
        },
        "content": {
          "type": "string",
          "minLength": 15,
          "maxLength": 15000
        },
        "example": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10000
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "visibility": {
          "enum": [
            "draft",
            "published",
            "retired"
          ]
        },
        "approvedBy": {
          "type": "string",
          "minLength": 3
        },
        "reviewedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "lessonIds",
        "access"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "lessonIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "access": {
          "enum": [
            "free",
            "paid"
          ]
        }
      }
    }
  }
}
